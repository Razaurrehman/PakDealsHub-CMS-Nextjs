generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  DISCONTINUED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum BannerStatus {
  ACTIVE
  INACTIVE
}

// Multi-tenancy root
model Site {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  logo        String?
  theme       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  categories            Category[]
  brands                Brand[]
  products              Product[]
  banners               Banner[]
  orders                Order[]
  reviews               Review[]
  blogCategories        BlogCategory[]
  blogs                 Blog[]
  tags                  Tag[]
  coupons               Coupon[]
  staticPages           StaticPage[]
  contactMessages       ContactMessage[]
  newsletterSubscribers NewsletterSubscriber[]
  activityLogs          ActivityLog[]
  media                 Media[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String
  passwordHash String
  role         Role     @default(EDITOR)
  avatar       String?
  isActive     Boolean  @default(true)
  siteId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]

  @@unique([email, siteId])
}

model Category {
  id            String   @id @default(cuid())
  name          String
  slug          String
  description   String?
  image         String?
  icon          String?
  emoji         String?
  boxColor      String?
  parentId      String?
  siteId        String
  metaTitle     String?
  metaDesc      String?
  ogImage       String?
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([slug, siteId])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String
  logo        String?
  description String?
  website     String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  siteId      String
  metaTitle   String?
  metaDesc    String?
  ogImage     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([slug, siteId])
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String
  sku             String?
  description     String?       @db.Text
  shortDesc       String?
  price           Float
  comparePrice    Float?
  costPrice       Float?
  images          String[]
  thumbnail       String?
  stock           Int           @default(0)
  lowStockAlert   Int           @default(5)
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  isNew           Boolean       @default(false)
  freeDelivery    Boolean       @default(false)
  warranty        String?
  deliveryDays    Int?
  rating          Float         @default(0)
  reviewCount     Int           @default(0)
  colors          String[]
  storages        String[]
  tags            String[]
  categoryId      String?
  brandId         String?
  siteId          String
  metaTitle       String?
  metaDesc        String?
  ogImage         String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id])
  brand     Brand?     @relation(fields: [brandId], references: [id])
  orderItems OrderItem[]
  reviews   Review[]

  @@unique([slug, siteId])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  passwordHash String
  avatar       String?
  isActive     Boolean  @default(true)
  siteId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([email, siteId])
}

model Banner {
  id          String       @id @default(cuid())
  title       String
  subtitle    String?
  tag         String?
  badge       String?
  image       String?
  link        String?
  buttonText  String?
  status      BannerStatus @default(ACTIVE)
  sortOrder   Int          @default(0)
  siteId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String   @id @default(cuid())
  code          String
  title         String
  description   String?
  discountType  String   @default("PERCENT")
  discountValue Float
  minOrderValue Float?
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int      @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  siteId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([code, siteId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  address         String?
  city            String?
  totalAmount     Float
  discountAmount  Float       @default(0)
  deliveryCharges Float       @default(0)
  finalAmount     Float
  status          OrderStatus @default(PENDING)
  paymentMethod   String?
  paymentStatus   String      @default("PENDING")
  notes           String?
  couponId        String?
  siteId          String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  coupon    Coupon?     @relation(fields: [couponId], references: [id])
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  image     String?
  price     Float
  qty       Int
  variant   String?
  subtotal  Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  comment   String?
  reviewer  String
  email     String?
  isApproved Boolean @default(false)
  productId String
  siteId    String
  createdAt DateTime @default(now())

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  image       String?
  isActive    Boolean  @default(true)
  siteId      String
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site  Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blogs Blog[]

  @@unique([slug, siteId])
}

model Blog {
  id             String     @id @default(cuid())
  title          String
  slug           String
  content        String?    @db.Text
  excerpt        String?
  thumbnail      String?
  featuredImage  String?
  ogImage        String?
  metaTitle      String?
  metaDesc       String?
  focusKeyword   String?
  authorName     String?
  readingTime    Int?
  status         BlogStatus @default(DRAFT)
  isFeatured     Boolean    @default(false)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  blogCategoryId String?
  siteId         String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blogCategory BlogCategory? @relation(fields: [blogCategoryId], references: [id])
  tags         BlogTag[]

  @@unique([slug, siteId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String
  siteId    String
  createdAt DateTime  @default(now())

  site  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blogs BlogTag[]

  @@unique([slug, siteId])
}

model BlogTag {
  blogId String
  tagId  String

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}

model StaticPage {
  id          String   @id @default(cuid())
  slug        String
  title       String
  content     String?  @db.Text
  metaTitle   String?
  metaDesc    String?
  ogImage     String?
  isPublished Boolean  @default(true)
  siteId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([slug, siteId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  siteId    String
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String
  isActive     Boolean  @default(true)
  siteId       String
  subscribedAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([email, siteId])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String?
  size      Int?
  siteId    String
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  siteId     String
  createdAt  DateTime @default(now())

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}
